# Copy to `.env` and adjust as needed:  cp .env.example .env
#
# `.env` is gitignored; this file is committed. That way the set of required
# variables is documented in the repository without any credential being
# committed alongside it.
#
# Split of responsibilities (see PROJECT_BRIEF.md 5):
#   .env                 -> connection strings and secrets (change per environment)
#   config/settings.yaml -> behavioural settings (partition size, buckets, body IDs)
# Both are merged into a single settings object by src/wrc_pipeline/config.py.
#
# Docker Compose reads this file automatically for ${VAR} substitution in
# docker-compose.yml, and the application reads it via python-dotenv, so the
# containers and the code cannot drift apart.

# --- Pipeline behaviour profile ---------------------------------------------
# Which YAML file supplies the behavioural settings. Behaviour is not
# overridable key-by-key from the environment on purpose: to run with different
# behaviour, point this at a different file and the whole profile swaps at once.
# Defaults to config/settings.yaml in the repository root.
# WRC_CONFIG_FILE=config/settings.yaml

# --- Logging ----------------------------------------------------------------
# How loudly a run logs and where those logs land is a property of where the
# pipeline is running, not of the pipeline, so it lives here and not in YAML.
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Optional. Logs always go to stdout; setting this ALSO writes them to a file,
# which is what makes the end-of-run summary easy to hand to a reviewer.
# Parent directories are created automatically.
# LOG_FILE=logs/pipeline.jsonl

# --- Orchestration ----------------------------------------------------------
# Where Dagster keeps its run history and event log. Optional: without it
# `dagster dev` uses a temporary directory and forgets everything between
# restarts, which is fine for a look around but loses materialisation history.
# Must be an ABSOLUTE path - Dagster rejects a relative one.
# DAGSTER_HOME=C:\Users\you\wrc-pipeline\.dagster_home

# --- Container images -------------------------------------------------------
# Pinned in docker-compose.yml; override here only to test a different version.
# MONGO_IMAGE=mongo:8.0.29
# MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z

# --- MongoDB ----------------------------------------------------------------
MONGO_ROOT_USERNAME=wrc
MONGO_ROOT_PASSWORD=wrc_local_dev_pw
MONGO_PORT=27017

# Assembled from the values above. Kept as one explicit variable rather than
# built in code, so pointing the pipeline at a managed cluster (Atlas, replica
# set, TLS) is a config change and not a code change.
# authSource=admin because the root user lives in the `admin` database.
MONGO_URI=mongodb://wrc:wrc_local_dev_pw@localhost:27017/?authSource=admin

# --- MinIO / S3 -------------------------------------------------------------
MINIO_ROOT_USER=wrcadmin
MINIO_ROOT_PASSWORD=wrc_local_dev_pw
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Endpoint is a full URL so that swapping MinIO for real AWS S3 means changing
# this line (or unsetting it) rather than editing the client code.
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_SECURE=false

# --- Orchestration ----------------------------------------------------------
# Where Dagster keeps its run history and event log. Left commented out because
# it must be an ABSOLUTE path and there is no default that is correct on both
# Windows and POSIX; with it unset, `dagster dev` runs from a temporary
# directory and forgets every run when it restarts, which is fine for a first
# look and unhelpful for anything else.
#
# Set it to a path inside this checkout, e.g.
#   DAGSTER_HOME=/absolute/path/to/WRC Scraping Pipeline/.dagster_home
#   DAGSTER_HOME=C:\absolute\path\to\WRC Scraping Pipeline\.dagster_home
# DAGSTER_HOME=
